    fig.update_yaxes(
        color=tema["texto"],
        tickfont=dict(color=tema["texto"]),
        title_font=dict(color=tema["texto"]),
    )

    st.plotly_chart(fig, use_container_width=True)

    # Gráfica de temperatura
