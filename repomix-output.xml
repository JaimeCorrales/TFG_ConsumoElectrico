    df_plot = (
        df_f.set_index(COL_TIMESTAMP)
        .groupby(COL_CUPS)[COL_KWH]
        .resample(freq)
        .sum()
        .reset_index()
    )

    # Gráfica de consumo histórico 
    st.markdown("### Consumo eléctrico histórico")

    if cups_sel == "Todos":
        # Media entre casas 
