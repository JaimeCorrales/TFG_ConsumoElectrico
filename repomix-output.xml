            df_agg,
            x=COL_TIMESTAMP,
            y=COL_KWH,
            labels={COL_KWH: "kWh", COL_TIMESTAMP: "Fecha"},
            template=tema["plotly"],
            color_discrete_sequence=[tema["real"]],
        )
        fig.update_traces(line_width=1.5)
    else:
        fig = px.line(
            df_plot,
            x=COL_TIMESTAMP,
            y=COL_KWH,
            labels={COL_KWH: "kWh", COL_TIMESTAMP: "Fecha"},
            template=tema["plotly"],
            color_discrete_sequence=[tema["real"]],
